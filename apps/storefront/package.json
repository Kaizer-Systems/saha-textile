{
  "name": "@saha-textile/storefront",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "styles": "sass --quiet --quiet-deps --no-source-map --load-path=node_modules src/scss/app.scss:src/scss/app.gen.css",
    "styles:watch": "sass --quiet --quiet-deps --no-source-map --load-path=node_modules --watch src/scss/app.scss:src/scss/app.gen.css",
    "predev": "pnpm run styles",
    "dev": "vite",
    "start": "node dist/analog/server/index.mjs",
    "prebuild": "pnpm run styles",
    "build": "vite build",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write \"**/*.{ts,html,scss,css,js,json,md}\""
  },
  "private": true,
  "dependencies": {
    "@analogjs/router": "^2.6.2",
    "@angular/animations": "^21.0.6",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.6",
    "@angular/compiler": "^21.0.6",
    "@angular/core": "^21.0.6",
    "@angular/forms": "^21.0.6",
    "@angular/localize": "^21.2.17",
    "@angular/platform-browser": "^21.0.6",
    "@angular/platform-browser-dynamic": "^21.0.6",
    "@angular/platform-server": "^21.0.6",
    "@angular/router": "^21.0.6",
    "@jsverse/transloco": "^8.4.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/entity": "^21.1.1",
    "@ngrx/signals": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngx-loading-bar/core": "^7.0.0",
    "@ngx-loading-bar/router": "^7.0.0",
    "@tanstack/angular-query-experimental": "^5.101.1",
    "bootstrap": "^5.3.3",
    "feather-icons": "^4.29.2",
    "ng-select2-component": "^16.0.0",
    "ngx-image-zoom": "^2.1.0",
    "ngx-owl-carousel-o": "^21.0.0",
    "ngx-toastr": "^19.0.0",
    "rxjs": "~7.8.0",
    "swiper": "^11.2.10",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.6.2",
    "@analogjs/vite-plugin-angular": "^2.6.2",
    "@analogjs/vitest-angular": "^2.6.2",
    "@angular-eslint/eslint-plugin": "^20.1.1",
    "@angular-eslint/eslint-plugin-template": "^20.1.1",
    "@angular-eslint/template-parser": "^20.1.1",
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.6",
    "@types/feather-icons": "^4.29.4",
    "@types/node": "^18.18.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.3",
    "front-matter": "^4.0.2",
    "globals": "17.7.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "sass": "^1.80.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
