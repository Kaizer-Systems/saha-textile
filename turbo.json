{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"globalEnv": ["NODE_ENV"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["BUILD_ID"],
			"outputs": ["dist/**", "!**/.angular/cache/**", "!**/.nitro/**"]
		},
		"styles": {
			"outputs": [
				"src/scss/app.gen.css",
				"public/assets/css/theme-dark.gen.css",
				"public/assets/scss/app.gen.css"
			]
		},
		"lint": {
			"dependsOn": ["^build", "styles"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
