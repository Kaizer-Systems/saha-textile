{
  "name": "@saha-textile/adapters-db-mongo",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "generate:catalogue": "node --import tsx scripts/generate-catalogue.ts",
    "seed": "tsx scripts/seed.ts",
    "align:collections": "tsx scripts/align-collection-names.ts",
    "split:admin-users": "tsx scripts/split-admin-users.ts",
    "rename:admin-user-permissions": "tsx scripts/rename-admin-user-permissions.ts",
    "extract:credentials": "tsx scripts/extract-credentials.ts",
    "seed:system-roles": "tsx scripts/seed-system-roles.ts",
    "reconcile:indexes": "tsx scripts/reconcile-indexes.ts"
  },
  "dependencies": {
    "@saha-textile/contracts": "workspace:*",
    "@saha-textile/core-domain": "workspace:*",
    "mongoose": "9.7.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
