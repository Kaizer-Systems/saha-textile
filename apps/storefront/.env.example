# =============================================================================
#  apps/storefront/.env  —  Storefront (Angular + Analog SSR) configuration
# =============================================================================
#  cp apps/storefront/.env.example apps/storefront/.env   (real .env is gitignored)
#
#  Angular has no NEXT_PUBLIC_* concept. Browser-facing config is delivered at
#  RUNTIME via public/config.json (loaded by an APP_INITIALIZER) so one image
#  runs in every environment — see project-context/angular-context/environment-variables.md.
#  Server-side env (Nitro/Analog SSR) reads these via process.env.
#  NEVER put secrets in anything shipped to the browser.
#  Tags: [LOCAL] [TEST-E2E] [PROD-E2E]
# =============================================================================

# ---- Dev server port (vite) ---------------------------------- [LOCAL] ------
PORT=3000

# ---- API endpoint (config.json -> apiUrl) -------------------- [ALL] --------
# [LOCAL]     http://localhost:4000
# [TEST-E2E]  https://api.test.<your-domain>
# [PROD-E2E]  https://api.<your-domain>
API_URL=http://localhost:4000

# ---- Site (config.json -> siteUrl / locales) ----------------- [ALL] --------
SITE_URL=http://localhost:3000
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,bn

# ---- Analytics (privacy-friendly, consent-gated) ---- [ALL, real later] -----
ANALYTICS_DOMAIN=
ANALYTICS_SCRIPT_URL=
