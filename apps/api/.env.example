# =============================================================================
#  apps/api/.env  —  API runtime configuration (NestJS on Fastify)
# =============================================================================
#  HOW TO USE
#    cp apps/api/.env.example apps/api/.env   (the real .env is gitignored)
#    Fill the values for the environment you are running.
#
#  LOCAL Mongo (locked architecture):
#    1) Start Docker engine (Desktop/Rancher) until `docker ps` works
#    2) pnpm mongo:up
#    3) Use the MONGODB_* values below (self-hosted RS, not Atlas)
#
#  SECURITY: the repo is PUBLIC. Never commit real values — only this template.
# =============================================================================

# ---- Runtime -------------------------------------------------- [ALL] --------
NODE_ENV=development
PORT=4000
# Comma-separated allowlist of browser origins permitted by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300

# ---- MongoDB (self-hosted Docker 8.3, replica set rs0) -------- [ALL] --------
# Preferred for LOCAL: either parts below OR a full MONGODB_URI.
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_REPLICA_SET=rs0
MONGODB_DB_NAME=saha_local
MONGODB_APP_NAME=saha-api-local
MONGODB_DIRECT_CONNECTION=true
# Local compose starts without auth. Droplet compose will set user/password + authSource=admin.
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# Optional full override (must include replicaSet=rs0; percent-encode password if present):
# MONGODB_URI=mongodb://127.0.0.1:27017/saha_local?replicaSet=rs0&directConnection=true

# ---- Search: Meilisearch -------------------------------------- [Phase F+] ---
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=

# ---- Auth: JWT / cookies -------------------------------------- [ALL] --------
# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Notifications (NotificationPort — MSG91 primary) -------- [ALL] --------
# Primary messaging = MSG91 behind NotificationPort (email + SMS + WhatsApp).
# Adapter-swappable / multi-adapter fallback for cost or outage — core never imports MSG91 SDK.
NOTIFICATION_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_SMS_SENDER_ID=
# MSG91_WHATSAPP_NUMBER=
MAIL_FROM=no-reply@sahatextile.com
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# Optional EmailPort fallback only (not primary):
EMAIL_PROVIDER=console
# RESEND_API_KEY=

# ---- Auth: social login (OAuth) ------------------- [ALL, real later] --------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=

# ---- Media storage: DigitalOcean Spaces (S3-compatible) ---- [Phase I+] ------
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=sgp1
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_CDN_URL=

# ---- Payments / shipping / FX --------------------- [ports first; live later] -
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
CCAVENUE_BASE_URL=https://test.ccavenue.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
EXCHANGERATE_API_KEY=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=

# ---- Rate limiting -------------------------------------------- [ALL] --------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ---- Edge / proxy (local off; droplet on) ---------------------- [deploy] ----
TRUST_PROXY=false
# CLIENT_IP_HEADER=cf-connecting-ip
