{
  "name": "@saha-textile/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "generate:openapi": "nest build && node dist/generate-openapi.js && node scripts/check-openapi.mjs",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "e2e:session-rotation": "node e2e/session-rotation.mjs",
    "check:openapi": "node scripts/check-openapi.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "9.3.0",
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-fastify": "11.1.27",
    "@nestjs/swagger": "11.4.5",
    "@saha-textile/adapters-db-mongo": "workspace:*",
    "@saha-textile/contracts": "workspace:*",
    "@saha-textile/core-domain": "workspace:*",
    "argon2": "0.44.0",
    "dotenv": "17.4.2",
    "fastify": "5.8.5",
    "jsonwebtoken": "9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.27",
    "@types/jsonwebtoken": "9.0.10",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
