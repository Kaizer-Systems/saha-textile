		"text": [
			"import {",
			"\tDEPLOY_SECRETS,",
			"\tDEPLOY_VARIABLES,",
			"\tDEPLOY_WORKFLOW,",
			"\ttype DeployJob,",
			"\ttype DeployRun,",
			"\tRELEASE_TAG,",
			"\ttype ReleaseTag,",
			"\tSERVER_TARGETS,",
			"\ttype ServerDeployView,",
			"\ttype ServerTarget,",
			"\tdeployFailureOf,",
			"\treleaseTagTime,",
			"} from '@saha-textile/release-console-contracts';",
			"",
			"import { VendorError, arr, getJson, num, rec, sendJson, str } from './http.js';",
			"",
			"const API = 'https://api.github.com';",
			"const GH = { 'x-github-api-version': '2022-11-28' };",
			"",
			"/** The HTTP calls this file makes, so tests can stand in for GitHub. */",
			"export interface GithubHttp {",
			"\tget: typeof getJson;",
			"\tsend: typeof sendJson;",
			"\t/** A job's log as text (GitHub answers with a redirect to the file), or `null` when it cannot be read. */",
			"\tlog: (url: string, key: string) => Promise<string | null>;",
			"}",
			"async function jobLog(url: string, key: string): Promise<string | null> {",
			"\tconst res = await fetch(url, {",
			"\t\theaders: { authorization: `Bearer ${key}`, 'user-agent': 'release-console', ...GH },",
			"\t\tredirect: 'follow',",
			"\t\tsignal: AbortSignal.timeout(20_000),",
			"\t}).catch(() => null);",
			"\treturn res?.ok ? res.text() : null;",
			"}",
			"const live: GithubHttp = { get: getJson, send: sendJson, log: jobLog };",
			"",
			"const nul = (v: unknown): string | null => (typeof v === 'string' ? v : null);",
			"const step = (s: unknown) => {",
			"\tconst r = rec(s);",
			"\treturn {",
			"\t\tname: str(r['name']),",
			"\t\tstatus: str(r['status']),",
			"\t\tconclusion: nul(r['conclusion']),",
			"\t\tstartedAt: nul(r['started_at']),",
			"\t\tcompletedAt: nul(r['completed_at']),",
			"\t};",
			"};",
			"export const toJob = (j: unknown): DeployJob => ({ ...step(j), steps: arr(rec(j)['steps']).map(step) });",
			"",
			"const failed = (what: string, status: number) => {",
			"\tif (status === 401)",
			"\t\treturn new VendorError('GitHub refused the key (401). Check it on the Connections screen.', 401);",
			"\tif (status === 403)",
			"\t\treturn new VendorError(",
			"\t\t\t`The GitHub key may not ${what} (403). It needs Actions, Environments and Deployments.`,",
			"\t\t\t403,",
			"\t\t);",
			"\treturn new VendorError(`GitHub answered ${status} when asked to ${what}.`, status);",
			"};",
			"",
			"/** Names in a list answer, or `null` when the key may not list them. */",
			"async function names(http: GithubHttp, url: string, key: string, field: string): Promise<string[] | null> {",
			"\tconst a = await http.get(url, key, GH);",
			"\tif (a.status === 403 || a.status === 404) return null;",
			"\tif (a.status >= 400) throw failed('list the environment', a.status);",
			"\treturn arr(rec(a.body)[field]).map((v) => str(rec(v)['name']));",
			"}",
			"",
			"async function exists(http: GithubHttp, url: string, key: string): Promise<boolean> {",
			"\tconst a = await http.get(url, key, GH);",
			"\tif (a.status === 404) return false;",
			"\tif (a.status >= 400) throw failed('read the repository', a.status);",
			"\treturn true;",
			"}",
			"",
			"/** The newest deploy.yml runs for one target, by their run name (`Deploy <target> · <branch>`). */",
			"async function runsOf(http: GithubHttp, repository: string, target: ServerTarget, key: string) {",
			"\tconst a = await http.get(",
			"\t\t`${API}/repos/${repository}/actions/workflows/${DEPLOY_WORKFLOW}/runs?per_page=30`,",
			"\t\tkey,",
			"\t\tGH,",
			"\t);",
			"\tif (a.status === 404) return [];",
			"\tif (a.status >= 400) throw failed('list deploy runs', a.status);",
			"\treturn (",
			"\t\tarr(rec(a.body)['workflow_runs'])",
			"\t\t\t.map(rec)",
			"\t\t\t// Rollbacks are named \"Roll back <target> · <ref>\" (deploy.yml run-name).",
			"\t\t\t.filter((r) =>",
			"\t\t\t\t[`Deploy ${target} `, `Roll back ${target} `].some((p) => str(r['display_title']).startsWith(p)),",
			"\t\t\t)",
			"\t\t\t.slice(0, 10)",
			"\t);",
			"}",
			"",
			"/** This environment's release tags (deploy.yml pushes one after each healthy deploy), newest first. */",
			"async function tagsOf(http: GithubHttp, repository: string, target: ServerTarget, key: string): Promise<ReleaseTag[]> {",
			"\tconst a = await http.get(`${API}/repos/${repository}/tags?per_page=100`, key, GH);",
			"\tif (a.status >= 400) return [];",
			"\treturn arr(a.body)",
			"\t\t.map(rec)",
			"\t\t.map((t) => ({",
			"\t\t\tname: str(t['name']),",
			"\t\t\tcommit: str(rec(t['commit'])['sha']).slice(0, 7),",
			"\t\t\tat: releaseTagTime(str(t['name'])),",
			"\t\t}))",
			"\t\t.filter((t): t is ReleaseTag => t.at !== null && RELEASE_TAG.exec(t.name)?.[1] === target)",
			"\t\t.sort((a, b) => b.name.localeCompare(a.name))",
			"\t\t.slice(0, 30);",
			"}",
			"",
			"/**",
			" * Everything Ship › Live deploy shows for a server environment: whether its GitHub environment is",
			" * set up for deploy.yml, the newest run with its jobs and steps, and the runs before it.",
			" */",
			"export async function serverDeployView(",
			"\trepository: string,",
			"\tenvironment: string,",
			"\ttarget: ServerTarget,",
			"\tkey: string,",
			"\thttp: GithubHttp = live,",
			"\t/** The environment's own branch (owner, 20 Nov); the target's when it names none. */",
			"\tchosen?: string,",
			"): Promise<ServerDeployView> {",
			"\tconst branch = chosen || SERVER_TARGETS[target].branch;",
			"\tconst base = `${API}/repos/${repository}`;",
			"\tconst repo = rec((await http.get(base, key, GH)).body);",
			"\tconst defaultBranch = str(repo['default_branch']) || 'main';",
			"\tconst [environmentExists, onBranch, onDefault, variables, secrets, runs, tags] = await Promise.all([",
			"\t\texists(http, `${base}/environments/${target}`, key),",
			"\t\texists(http, `${base}/contents/.github/workflows/${DEPLOY_WORKFLOW}?ref=${branch}`, key),",
			"\t\texists(http, `${base}/contents/.github/workflows/${DEPLOY_WORKFLOW}?ref=${defaultBranch}`, key),",
			"\t\tnames(http, `${base}/environments/${target}/variables?per_page=30`, key, 'variables'),",
			"\t\tnames(http, `${base}/environments/${target}/secrets?per_page=30`, key, 'secrets'),",
			"\t\trunsOf(http, repository, target, key),",
			"\t\ttagsOf(http, repository, target, key),",
			"\t]);",
			"\tconst summary = (r: Record<string, unknown>) => ({",
			"\t\tid: num(r['id']),",
			"\t\turl: str(r['html_url']),",
			"\t\tbranch: str(r['head_branch']),",
			"\t\tcommit: str(r['head_sha']).slice(0, 7),",
			"\t\tstatus: str(r['status']),",
			"\t\tconclusion: nul(r['conclusion']),",
			"\t\tcreatedAt: str(r['created_at']),",
			"\t});",
			"\tlet run: DeployRun | null = null;",
			"\tconst newest = runs[0];",
			"\tif (newest) {",
			"\t\tconst id = num(newest['id']);",
			"\t\tconst jobs = arr(",
			"\t\t\trec((await http.get(`${base}/actions/runs/${id}/jobs?per_page=100`, key, GH)).body)['jobs'],",
			"\t\t).map(toJob);",
			"\t\tlet waiting: number[] = [];",
			"\t\tif (str(newest['status']) === 'waiting') {",
			"\t\t\tconst pending = await http.get(`${base}/actions/runs/${id}/pending_deployments`, key, GH);",
			"\t\t\twaiting = arr(pending.body).map((p) => num(rec(rec(p)['environment'])['id']));",
			"\t\t}",
			"\t\trun = { ...summary(newest), waiting, jobs };",
			"\t}",
			"\t// Why the newest run did not go live: the failed job's log names the step and its message.",
			"\tlet failure = null;",
			"\tif (run?.conclusion === 'failure') {",
			"\t\tconst raw = arr(rec((await http.get(`${base}/actions/runs/${run.id}/jobs?per_page=100`, key, GH)).body)['jobs'])",
			"\t\t\t.map(rec)",
			"\t\t\t.find((j) => str(j['conclusion']) === 'failure');",
			"\t\tconst text = raw ? await http.log(`${base}/actions/jobs/${num(raw['id'])}/logs`, key) : null;",
			"\t\tfailure = text ? deployFailureOf(text.split('\\n').slice(-600)) : null;",
			"\t}",
			"\treturn {",
			"\t\tenvironment,",
			"\t\ttarget,",
			"\t\tbranch,",
			"\t\tsetup: {",
			"\t\t\tenvironmentExists,",
			"\t\t\tmissingVariables: variables && DEPLOY_VARIABLES.filter((v) => !variables.includes(v)),",
			"\t\t\tmissingSecrets: secrets && DEPLOY_SECRETS.filter((s) => !secrets.includes(s)),",
			"\t\t\tworkflowOnBranch: onBranch && onDefault,",
			"\t\t},",
			"\t\trun,",
			"\t\trecent: runs.slice(1).map(summary),",
			"\t\tfailure,",
			"\t\ttags,",
			"\t};",
			"}",
			"",
			"/** What one start of deploy.yml asks for beyond the target: rotation, a rollback or an older version. */",
			"export interface DeployOptions {",
			"\trotate?: boolean;",
			"\trestartDatabase?: boolean;",
			"\taction?: 'deploy' | 'rollback';",
			"\ttag?: string;",
			"}",
			"",
			"/**",
			" * Starts deploy.yml for one target on a branch: the one chosen for the run or the environment",
			" * (owner, 20 Nov), else the target's own (staging, main). The target's GitHub environment may only",
			" * allow some branches; GitHub then refuses and the console says so.",
			" */",
			"export async function startServerDeploy(",
			"\trepository: string,",
			"\ttarget: ServerTarget,",
			"\tkey: string,",
			"\thttp: GithubHttp = live,",
			"\tchosen?: string,",
			"\tallowBlank: readonly string[] = [],",
			"\toptions: DeployOptions = {},",
			"): Promise<void> {",
			"\tconst branch = options.tag || chosen || SERVER_TARGETS[target].branch;",
			"\t// Only the inputs this start needs, so a deploy.yml without the newer ones still takes a plain deploy.",
			"\tconst inputs: Record<string, string> = { environment: target, allow_blank: [...new Set(allowBlank)].join(',') };",
			"\tif (options.rotate) inputs['rotate'] = 'true';",
			"\tif (options.rotate && options.restartDatabase) inputs['restart_database'] = 'true';",
			"\tif (options.action === 'rollback') inputs['action'] = 'rollback';",
			"\tconst a = await http.send(",
			"\t\t'POST',",
			"\t\t`${API}/repos/${repository}/actions/workflows/${DEPLOY_WORKFLOW}/dispatches`,",
			"\t\tkey,",
			"\t\t{ ref: branch, inputs },",
			"\t\tGH,",
			"\t);",
			"\tif (a.status === 404)",
			"\t\tthrow new VendorError(`deploy.yml is not on ${branch} and the default branch yet; merge it there first.`, 409);",
			"\tif (a.status === 422) {",
			"\t\tconst said = str(rec(a.body)['message']);",
			"\t\tif (/unexpected inputs/i.test(said))",
			"\t\t\tthrow new VendorError(",
			"\t\t\t\t`deploy.yml on ${branch} does not take ${options.action === 'rollback' ? 'a rollback' : 'rotation'} yet; the deploy-script side lands first.`,",
			"\t\t\t\t409,",
			"\t\t\t);",
			"\t\tthrow new VendorError(",
			"\t\t\toptions.tag",
			"\t\t\t\t? `GitHub would not start deploy.yml on ${branch}: the ${target} environment's rules may not allow its tags yet (Finish setup adds ${target}-*).`",
			"\t\t\t\t: `GitHub would not start deploy.yml on ${branch}: the ${target} environment's rules may not allow that branch.`,",
			"\t\t\t409,",
			"\t\t);",
			"\t}",
			"\tif (a.status !== 204) throw failed('start the deploy', a.status);",
			"}",
			"",
			"/** Approves or rejects a run that waits for the owner on its GitHub environment. */",
			"export async function reviewServerDeploy(",
			"\trepository: string,",
			"\trunId: number,",
			"\tenvironmentIds: number[],",
			"\tapprove: boolean,",
			"\tkey: string,",
			"\thttp: GithubHttp = live,",
			"): Promise<void> {",
			"\tconst a = await http.send(",
			"\t\t'POST',",
			"\t\t`${API}/repos/${repository}/actions/runs/${runId}/pending_deployments`,",
			"\t\tkey,",
			"\t\t{",
			"\t\t\tenvironment_ids: environmentIds,",
			"\t\t\tstate: approve ? 'approved' : 'rejected',",
			"\t\t\tcomment: approve ? 'Approved in the Release Console with the PIN.' : 'Rejected in the Release Console.',",
			"\t\t},",
			"\t\tGH,",
			"\t);",
			"\tif (a.status >= 400) throw failed(approve ? 'approve the deploy' : 'reject the deploy', a.status);",
			"}"
		],
