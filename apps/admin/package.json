{
  "name": "@saha-textile/admin",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "styles": "sass --quiet --quiet-deps --no-source-map --load-path=public/assets/scss --load-path=node_modules --load-path=../../node_modules public/assets/scss/app.scss:public/assets/scss/app.gen.css",
    "dev": "vite",
    "start": "vite preview --host localhost --port 4300 --strictPort",
    "start:watch": "node ../../scripts/serve-built-frontend.mjs --app admin",
    "build": "vite build",
    "watch": "vite build --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@saha-textile/http-transport": "workspace:*",
