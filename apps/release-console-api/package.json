{
  "name": "@saha-textile/release-console-api",
  "version": "0.0.0",
  "private": true,
  "description": "The Release Console's local API. Runs only on the owner's computer, bound to 127.0.0.1; never deployed.",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@saha-textile/release-console-contracts": "workspace:*",
    "fastify": "5.12.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/node": "^24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
