# =============================================================================
#  apps/storefront/.env  —  Storefront (Next.js) configuration
# =============================================================================
#  cp apps/storefront/.env.example apps/storefront/.env   (real .env is gitignored)
#
#  NEXT_PUBLIC_* values are exposed to the browser — NEVER put secrets there.
#  Tags: [LOCAL] [TEST-E2E] [PROD-E2E]
# =============================================================================

# ---- API endpoint -------------------------------------------- [ALL] --------
# [LOCAL]     http://localhost:4000
# [TEST-E2E]  https://api.test.<your-domain>
# [PROD-E2E]  https://api.<your-domain>
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Site ---------------------------------------------------- [ALL] --------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,bn

# ---- Analytics (privacy-friendly, consent-gated) ---- [ALL, real later] -----
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
