# =============================================================================
#  apps/admin/.env  —  Admin panel (Next.js) configuration
# =============================================================================
#  cp apps/admin/.env.example apps/admin/.env   (real .env is gitignored)
#
#  NEXT_PUBLIC_* values are exposed to the browser — NEVER put secrets there.
#  Tags: [LOCAL] [TEST-E2E] [PROD-E2E]
# =============================================================================

# ---- API endpoint -------------------------------------------- [ALL] --------
# [LOCAL]     http://localhost:4000
# [TEST-E2E]  https://api.test.<your-domain>
# [PROD-E2E]  https://api.<your-domain>
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Site ---------------------------------------------------- [ALL] --------
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
