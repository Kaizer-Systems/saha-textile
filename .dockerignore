# Build context for docker/images/Dockerfile. Nothing secret or machine-local enters an image:
# env files, certificates and MCP config are runtime inputs, never build inputs.
**/node_modules
**/dist
**/build
**/.angular
**/.nitro
**/.turbo
**/.docusaurus
**/coverage
**/*.tsbuildinfo
.git
.env
.env.*
**/.env
**/.env.*
!**/.env.example
certs
.production-proof
.local-release
docker/stack/env/*.env
docker/stack/env/redis-password
docker/stack/env/meilisearch.toml
docker/stack/env/*.tmp
docker/stack/env
docker/dev-secrets
.claude
.cursor
.vscode
vendor
project-context
apps/developer-portal*
docs

# Release Console key file, real secrets
docker/release-console/env
docker/release-console/runner.log
