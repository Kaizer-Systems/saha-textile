{
  "name": "saha-textile",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm check:naming",
    "check:naming": "bash scripts/check-naming.sh",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mongo:up": "bash scripts/mongo-up.sh",
    "mongo:down": "bash scripts/mongo-down.sh",
    "mongo:status": "bash scripts/mongo-status.sh",
    "mongo:wipe": "bash scripts/mongo-wipe.sh"
  },
  "devDependencies": {
    "@saha-textile/config": "workspace:*",
    "@types/node": "^24",
    "eslint": "10.5.0",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "turbo": "2.10.0",
    "typescript": "6.0.3"
  }
}
