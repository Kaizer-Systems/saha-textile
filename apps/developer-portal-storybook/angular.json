{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"projects": {
		"developer-portal-storybook": {
			"projectType": "application",
			"root": ".",
			"sourceRoot": "src",
			"prefix": "portal",
			"architect": {
				"build": {
					"builder": "@angular-devkit/build-angular:browser",
					"options": {
						"outputPath": "dist/angular-shell",
						"index": "src/index.html",
						"main": "src/main.ts",
						"polyfills": ["zone.js"],
						"tsConfig": "tsconfig.app.json",
						"assets": [],
						"styles": [
							"node_modules/@fontsource-variable/inter/index.css",
							"node_modules/@fontsource-variable/jetbrains-mono/index.css",
							"../developer-portal/src/css/nextgen-theme.css",
							".storybook/preview.css"
						],
						"scripts": []
					}
				},
				"storybook": {
					"builder": "@storybook/angular:start-storybook",
					"options": {
						"configDir": ".storybook",
						"browserTarget": "developer-portal-storybook:build",
						"host": "127.0.0.1",
						"port": 6006,
						"open": false,
						"ci": true,
						"compodoc": false
					}
				},
				"build-storybook": {
					"builder": "@storybook/angular:build-storybook",
					"options": {
						"configDir": ".storybook",
						"browserTarget": "developer-portal-storybook:build",
						"outputDir": "dist",
						"compodoc": false
					}
				}
			}
		}
	},
	"cli": {
		"analytics": false
	}
}
