{
  "name": "saha-textile",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "build:product-apps": "turbo run build --filter=@saha-textile/storefront --filter=@saha-textile/admin --filter=@saha-textile/api",
    "dev": "node scripts/secrets/cli.mjs pull --auto && turbo run dev",
    "dev:storefront": "pnpm --filter @saha-textile/storefront dev",
    "dev:admin": "pnpm --filter @saha-textile/admin dev",
    "start:storefront": "node scripts/serve-built-frontend.mjs --app storefront",
    "start:admin": "node scripts/serve-built-frontend.mjs --app admin",
    "lint": "pnpm check:nitro-handlers && pnpm check:naming && pnpm check:account-naming && pnpm check:browser-auth && pnpm check:i18n-parity && pnpm check:route-contracts && pnpm check:route-authorization && pnpm check:permission-registry && pnpm check:icon-titles && pnpm check:infisical-names && pnpm check:e2e-types && turbo run lint",
    "check:nitro-handlers": "node scripts/check-nitro-handlers.mjs",
    "check:naming": "bash scripts/check-naming.sh",
    "check:account-naming": "node scripts/check-account-naming.mjs",
    "setup:local-https": "bash scripts/setup-local-https.sh",
    "check:browser-auth": "node scripts/check-browser-auth.mjs",
    "check:i18n-parity": "node scripts/check-i18n-parity.mjs",
    "check:route-contracts": "node scripts/check-route-contracts.mjs",
    "check:route-authorization": "node scripts/check-route-authorization.mjs",
    "check:permission-registry": "node scripts/check-permission-registry.mjs",
    "check:icon-titles": "node scripts/check-icon-titles.mjs",
    "check:infisical-names": "node scripts/check-infisical-names.mjs",
    "test:scripts": "node --test scripts/secrets/*.test.mjs scripts/pipeline/*.test.mjs scripts/release-console/*.test.mjs scripts/server/*.test.mjs scripts/deploy/*.test.mjs",
    "secrets:status": "node scripts/secrets/cli.mjs status",
    "secrets:pull": "node scripts/secrets/cli.mjs pull",
    "secrets:setup-local": "node scripts/secrets/cli.mjs setup-local",
    "secrets:release": "node scripts/secrets/cli.mjs release",
    "secrets:generate": "node scripts/secrets/cli.mjs generate",
    "secrets:rotate": "node scripts/secrets/cli.mjs rotate",
    "local-auth:proof": "bash scripts/local-auth-proof.sh",
    "check:e2e-types": "tsc --noEmit -p e2e/tsconfig.json",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "coverage": "node scripts/coverage.mjs",
    "e2e": "playwright test",
    "e2e:stack": "node e2e/stack/run.mjs",
    "e2e:console": "playwright test -c apps/release-console/playwright.config.ts",
    "e2e:console:loaders": "CONSOLE_E2E_LOADERS=1 playwright test -c apps/release-console/playwright.config.ts",
    "e2e:session-rotation": "turbo run build --filter=@saha-textile/api && pnpm --filter @saha-textile/api e2e:session-rotation",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "portal:persistent": "node scripts/serve-developer-portal-persistent.mjs",
    "mongo:up": "bash scripts/mongo-up.sh",
    "mongo:down": "bash scripts/mongo-down.sh",
    "mongo:status": "bash scripts/mongo-status.sh",
    "mongo:wipe": "bash scripts/mongo-wipe.sh",
    "mongo:align-collections": "pnpm --filter @saha-textile/adapters-db-mongo align:collections",
    "mongo:split-admin-users": "pnpm --filter @saha-textile/adapters-db-mongo split:admin-users",
    "mongo:rename-admin-user-permissions": "pnpm --filter @saha-textile/adapters-db-mongo rename:admin-user-permissions",
    "mongo:extract-credentials": "pnpm --filter @saha-textile/adapters-db-mongo extract:credentials",
    "auth:set-local-credentials": "pnpm --filter @saha-textile/api set:local-credentials",
    "mongo:reconcile-indexes": "pnpm --filter @saha-textile/adapters-db-mongo reconcile:indexes",
    "local:refresh": "pnpm --filter @saha-textile/api release:steps",
    "stack:certs": "bash scripts/stack.sh certs",
    "stack:env": "bash scripts/stack.sh env",
    "stack:up": "bash scripts/stack.sh up",
    "stack:down": "bash scripts/stack.sh down",
    "stack:logs": "bash scripts/stack.sh logs",
    "stack:status": "bash scripts/stack.sh status",
    "production:proof": "bash scripts/production-proof.sh",
    "pipeline:local": "node scripts/pipeline/local.mjs",
    "redis:up": "bash scripts/redis-up.sh",
    "redis:down": "docker compose -f docker/redis/compose.yaml down",
    "server:plan": "node scripts/server/servers.mjs plan",
    "server:create": "node scripts/server/servers.mjs create",
    "server:destroy": "node scripts/server/servers.mjs destroy",
    "console:env": "node scripts/release-console/env.mjs",
    "console:up": "node scripts/release-console/up.mjs up",
    "console:down": "node scripts/release-console/up.mjs down",
    "console:runner": "node scripts/release-console/runner.mjs",
    "console:logs": "docker compose -f docker/release-console/compose.yaml logs -f --tail 200",
    "console": "turbo run dev --filter=@saha-textile/release-console --filter=@saha-textile/release-console-api",
    "lint:shop": "pnpm check:nitro-handlers && pnpm check:naming && pnpm check:account-naming && pnpm check:browser-auth && pnpm check:i18n-parity && pnpm check:route-contracts && pnpm check:route-authorization && pnpm check:permission-registry && pnpm check:icon-titles && pnpm check:infisical-names && pnpm check:e2e-types && turbo run lint --filter='!@saha-textile/release-console' --filter='!@saha-textile/release-console-api' --filter='!@saha-textile/release-console-contracts'",
    "typecheck:shop": "turbo run typecheck --filter='!@saha-textile/release-console' --filter='!@saha-textile/release-console-api' --filter='!@saha-textile/release-console-contracts'",
    "check:console": "turbo run lint typecheck test build --filter=@saha-textile/release-console --filter=@saha-textile/release-console-api --filter=@saha-textile/release-console-contracts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@saha-textile/config": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
