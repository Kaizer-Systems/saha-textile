    "@ngrx/entity": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@tanstack/angular-query-experimental": "^5.104.5",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ngx-loading-bar/core": "^7.0.1",
    "@ngx-loading-bar/http-client": "^7.0.1",
    "@ngx-loading-bar/router": "^7.0.1",
    "@jsverse/transloco": "^8.4.0",
    "apexcharts": "^8.5.0",
    "bootstrap": "^5.3.8",
    "feather-icons": "^4.29.2",
    "ng-apexcharts": "3.2.0",
    "ng-select2-component": "^19.1.0",
    "ngx-dropzone": "^3.1.0",
    "ngx-editor": "^19.1.1",
    "ngx-owl-carousel-o": "^22.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3",
