{
  "name": "@saha-textile/storefront",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "styles": "sass --quiet --quiet-deps --no-source-map --load-path=node_modules src/scss/app.scss:src/scss/app.gen.css",
    "styles:watch": "sass --quiet --quiet-deps --no-source-map --load-path=node_modules --watch src/scss/app.scss:src/scss/app.gen.css",
    "predev": "pnpm run styles",
    "dev": "vite",
    "start": "node dist/analog/server/index.mjs",
    "start:watch": "node ../../scripts/serve-built-frontend.mjs --app storefront",
    "prebuild": "pnpm run styles",
    "build": "vite build",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "prelint": "pnpm run styles",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write \"**/*.{ts,html,scss,css,js,json,md}\""
  },
  "dependencies": {
    "@saha-textile/http-transport": "workspace:*",
    "@analogjs/router": "^2.9.2",
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@jsverse/transloco": "^8.4.0",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/entity": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngx-loading-bar/core": "^7.0.1",
    "@ngx-loading-bar/router": "^7.0.1",
    "@tanstack/angular-query-experimental": "^5.104.5",
    "bootstrap": "^5.3.8",
    "feather-icons": "^4.29.2",
    "ng-select2-component": "^19.1.0",
    "ngx-image-zoom": "^3.0.0",
    "ngx-owl-carousel-o": "^22.0.0",
    "rxjs": "~7.8.0",
    "swiper": "^14.3.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3",
    "@damjantonkli/ngx-toastr": "22.0.2"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.9.2",
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@analogjs/vitest-angular": "^2.9.2",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@types/feather-icons": "^4.29.4",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "front-matter": "^4.0.2",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
