# =============================================================================
#  apps/api/.env  —  API runtime configuration (NestJS on Fastify)
# =============================================================================
#  HOW TO USE
#    pnpm secrets:pull   writes the real (gitignored) .env from the Infisical
#                        dev project; pnpm dev refreshes it before each run.
#                        Personal changes go in apps/api/.env.overrides.
#    Without Infisical access:
#    cp apps/api/.env.example apps/api/.env   and fill the values by hand.
#
#  Tags below show which environment(s) each var applies to:
#    [LOCAL]     local development against the local Docker MongoDB replica set
#    [TEST-E2E]  short-lived real infra (test droplet, Docker MongoDB)
#    [PROD-E2E]  production droplet (Docker MongoDB)
#
#  SECURITY: the repo is PUBLIC. Never commit real values — only this template.
#  Values live in Infisical, one project per tier (docker/infisical/README.md).
#  Deploys receive them as root-only files mounted read-only. Secrets reach the
#  API container ONLY — never the Angular apps (they get public config.json).
# =============================================================================

# ---- Runtime -------------------------------------------------- [ALL] --------
NODE_ENV=development
# Where this process runs: local | staging | production. Separate from NODE_ENV,
# which says how the code was BUILT. With NODE_ENV=production the API refuses to
# start on unsafe settings (default secrets, localhost CORS, console notifier,
# open Mongo/Redis, unset media storage …) UNLESS DEPLOY_ENV=local — so a deploy
# that forgets this variable is held to production rules. The mode-3 Docker
# stack sets DEPLOY_ENV=local itself. Leave unset for plain local development.
# DEPLOY_ENV=
PORT=4000
# Comma-separated allowlist of browser origins permitted by CORS.
# LOCAL: storefront :4200 + admin :4300 + persistent portal :3457.
# Deploys: explicit real origins only.
CORS_ALLOWED_ORIGINS=https://localhost:4200,https://localhost:4300,http://127.0.0.1:3457,http://localhost:3457

# ---- Reverse proxy / client IP ------------------- [deploys behind Nginx] ----
# LOCAL: false / empty. TEST/PROD (Cloudflare → Nginx → API):
#   TRUST_PROXY=true and CLIENT_IP_HEADER=cf-connecting-ip so rate-limiting
#   and audit logs see the real client IP, not the proxy.
TRUST_PROXY=false
CLIENT_IP_HEADER=

# Pino log level for request/application logs. Secrets (authorization, cookie,
# set-cookie, x-csrf-token, password/pin/code/token bodies) are redacted at the
# logger regardless of level. Tests force `silent`.
LOG_LEVEL=info
# json (one JSON line per event, the default in production) or pretty (coloured lines for a terminal).
LOG_FORMAT=

# ---- MongoDB (self-hosted Docker 8.3, single-node replica set rs0) -- [ALL] --
# Same Docker profile in local/test/prod (see docker/mongo + `pnpm mongo:up`).
# The password may contain special characters (e.g. '@'); store it RAW here —
# the app percent-encodes it at runtime via encodeURIComponent(). Do NOT pre-encode.
# LOCAL default profile runs without auth: leave USERNAME/PASSWORD empty.
# If your machine already runs a native mongod on 27017, override the Docker
# host port via gitignored docker/mongo/.env (MONGO_HOST_PORT) and mirror the
# same value in MONGODB_PORT here — see docker/mongo/docker-compose.yml.
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_REPLICA_SET=rs0
MONGODB_DB_NAME=saha_textile_local
MONGODB_APP_NAME=saha-textile-api
# Optional: fully override the assembled URI (must be pre-encoded and include
# replicaSet=rs0). e.g. mongodb://127.0.0.1:27017/saha_textile_local?replicaSet=rs0&directConnection=true
# MONGODB_URI=

# ---- Search: Meilisearch (self-hosted, behind SearchPort) --- [Chunk F] ------
# Blank means search answers 503. Local: http://127.0.0.1:7700 and the key in docker/stack/compose.yaml.
# After pointing at an empty index, run: pnpm --filter @saha-textile/api search:rebuild
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
# Index name. Leave empty for `products`.
MEILISEARCH_INDEX=

# ---- Auth: JWT (transitional bearer until Chunk D cookie sessions) - [ALL] ---
# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Auth: cookie sessions + CSRF (wired fully in Chunk D) --------- [ALL] ---
# httpOnly/Secure/SameSite cookie sessions with double-submit CSRF are the
# locked target; names/placeholders live here so deploy tooling stays stable.
# COOKIE_DOMAIN: leave empty everywhere. Cookies stay on the API host (__Host- prefix); the apps
# get the CSRF token from the API reply, so nothing needs a shared domain.
COOKIE_DOMAIN=
ACCESS_COOKIE_NAME=st_access
REFRESH_COOKIE_NAME=st_refresh
CSRF_COOKIE_NAME=st_csrf
CSRF_HEADER_NAME=x-csrf-token
# Generate with: openssl rand -hex 48
CSRF_SECRET=
# The keys before the last planned change, kept 30 days so nobody is signed out; blank after a leak.
# Set by `pnpm secrets:rotate` (servers), never by hand.
CSRF_SECRET_PREVIOUS=
JWT_ACCESS_SECRET_PREVIOUS=
JWT_REFRESH_SECRET_PREVIOUS=

# ---- Notifications: MSG91 primary via NotificationPort ------------- [ALL] ---
# Provider: console (LOCAL default — logs instead of sending) | msg91 (real).
# MSG91 covers SMS / WhatsApp / Email (incl. auth OTP) behind NotificationPort.
# Authkey is API env ONLY — never pasted in admin UI (owner lock option A).
NOTIFICATION_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# From address per group on Settings › Communications; all four are aliases of
# wecare@sahatextile.com. Blank = the address shown here.
MSG91_EMAIL_FROM_ACCOUNT=no-reply@sahatextile.com
MSG91_EMAIL_FROM_ORDERS=orders@sahatextile.com
MSG91_EMAIL_FROM_SHOP=notifications@sahatextile.com
MSG91_EMAIL_FROM_MARKETING=newsletter@sahatextile.com
MSG91_EMAIL_DOMAIN=
MSG91_WHATSAPP_NUMBER=
# Secret part of MSG91's delivery-receipt address (sent as ?token=, logged as {{token}}).
# Blank = the receipt address is off. Make one per environment: openssl rand -hex 24
MSG91_RECEIPT_TOKEN=
# The Release Console's read-only /ops address: the bearer key it sends. Blank = /ops answers 404.
# Make one per environment: openssl rand -hex 32
OPS_TOKEN=

# ---- Notifications: optional email FALLBACK only (never primary) --- [ALL] ---
# disabled (default) | resend | ses | smtp — adapter-swappable email fallback
# behind NotificationPort/EmailPort. MSG91 remains the primary provider.
EMAIL_FALLBACK_PROVIDER=disabled
RESEND_API_KEY=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ---- Auth: OTP policy ---------------------------------------------- [ALL] ---
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# LOCAL ONLY. Six digits issued as every one-time code while no notification provider
# is wired. Boot refuses it with NODE_ENV=production or NOTIFICATION_PROVIDER!=console.
OTP_LOCAL_FIXED_CODE=

# ---- Auth: social login (OAuth) ------------------- [ALL, real later] --------
# Client IDs are public (also delivered to Angular via config.json);
# SECRETS live only here in the API env — never in the browser.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=

# ---- Business documents (PDF) ------------------------------------------------
# Purchase orders now, tax invoices later (owner decision 2026-11-17). The worker draws them
# with headless Chromium: locally the installed Chrome, in the image Alpine's own Chromium.
PDF_CHROMIUM_CHANNEL=chrome
# PDF_CHROMIUM_EXECUTABLE=
# PDF_CHROMIUM_NO_SANDBOX=false
# PDF_RENDER_TIMEOUT_MS=30000

# ---- Job queue: Redis (BullMQ broker for media/transcode workers) --[Chunk I]--
# Queue broker only: not a cache and not a session store, so nothing here is on the
# request path. Password is optional locally and REQUIRED in any deployed environment.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Media storage: DigitalOcean Spaces (S3-compatible, SGP1 / Singapore) - [Phase 4+] ----
# Deployments inject a separate bucket-scoped key pair and bucket per environment.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=sgp1
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_CDN_URL=

# ---- Media pipeline (owner log § Media) ----
# Locales whose alt text a live banner must carry (en + fr now; bn later, as data).
ACTIVE_LOCALES=en,bn
# Worker encodes at low concurrency so uploads never starve SSR on the shared droplet.
MEDIA_WORKER_CONCURRENCY=2
# The daily GC runs as a dry run (audit only) until this is switched on deliberately.
MEDIA_GC_LIVE=false
# Cloudflare purge (staging/prod): both or neither. Unset = purges are logged (dev).
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=
# YouTube Data API v3 (PDP Validate + daily rail refresh). Unset = Validate answers "unavailable".
YOUTUBE_API_KEY=
# The shop's own address, which the worker asks for each page in every shop language just after a Page Builder
# switch (FX-8 cache warming). Unset = no warming; the switch still happens on time. Local: https://localhost:4200
SHOP_ORIGIN=

# ---- Gmail mailboxes in the admin + Contact Us delivery ----
# A second, free Google Cloud project with Internal consent (no Pub/Sub, no billing).
# All five or none. Unset = mailbox screens say "not set up"; Contact Us messages wait in the DB.
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
# The API's callback, registered on the Google client: https://<api-host>/admin/mailboxes/oauth/callback
GOOGLE_MAIL_REDIRECT_URI=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored refresh tokens.
MAILBOX_TOKEN_KEY=
# The mailbox key before the last planned change: tokens move to the new key when read (30 days).
MAILBOX_TOKEN_KEY_PREVIOUS=
# Where the browser returns after Google's sign-in (the admin app's origin).
ADMIN_APP_URL=
# Only mailboxes on this domain can be connected.
MAILBOX_DOMAIN=sahatextile.com

# ---- Payments: CCAvenue (INR gateway role; adapter-swappable) - [Phase 6] ----
# All four or none. Unset = payment calls answer "not configured".
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
# The one return address registered with HDFC: https, no query, 100 characters at most.
CCAVENUE_RETURN_URL=
# Payment page host: https://test.ccavenue.com (test) | https://secure.ccavenue.com (prod)
CCAVENUE_BASE_URL=https://test.ccavenue.com
# Merchant API host: https://apitest.ccavenue.com (test) | https://api.ccavenue.com (prod)
CCAVENUE_API_URL=https://apitest.ccavenue.com

# ---- Payments: PayPal (non-INR) --------------------------- [Phase 6] --------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live. Must fit DEPLOY_ENV: live only in production, sandbox everywhere else; a mismatch
# leaves PayPal off with one startup line (orders brief, owner 2026-11-20).
PAYPAL_ENV=sandbox
# The webhook's id from PayPal's dashboard, once the webhook is registered (checks webhook signatures).
PAYPAL_WEBHOOK_ID=

# ---- FX rates: ExchangeRate-API (free open tier needs no key) -- [Phase 7] ---
EXCHANGERATE_API_KEY=

# ---- Shipping: Shiprocket (domestic + international) ------- [Phase 6] --------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=

# ---- Rate limiting -------------------------------------------- [ALL] --------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Local HTTPS (development only) — `pnpm setup:local-https` issues these from the
# machine-local mkcert CA into a gitignored certs/ directory. Local development runs TLS so
# session cookies carry the SAME `Secure` + `__Host-` attributes as production; deriving
# that from NODE_ENV meant the production cookie path was never executed locally.
# Deploys leave BOTH unset: Nginx terminates TLS and the API speaks HTTP behind it.
TLS_CERT_FILE=../../certs/localhost-cert.pem
TLS_KEY_FILE=../../certs/localhost-key.pem

# Opt-OUT, defaults true. Only set false for a deliberate plain-HTTP local run; it also
# drops the __Host- cookie prefix, which the browser would otherwise reject.
# COOKIE_SECURE=true

# --- Provider template ids for OTP delivery (MSG91) --------------------------
# Saha Textile generates, stores and verifies every OTP itself (owner lock): MSG91 is the
# DELIVERY channel only — never the OTP Widget and never SendOTP. These ids point at the
# templates the code is sent THROUGH.
#
# Placeholders until the MSG91 account exists. Real ids are created in the MSG91 console and
# for SMS must additionally be registered on TRAI DLT before India delivery will work.
MSG91_TEMPLATE_OTP_EMAIL=tmpl_otp_email_placeholder
MSG91_TEMPLATE_OTP_SMS=tmpl_otp_sms_placeholder
