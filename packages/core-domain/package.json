{
  "name": "@saha-textile/core-domain",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./legacy-resolve": {
      "types": "./dist/catalog/legacy-resolve.d.ts",
      "import": "./dist/esm/legacy-resolve.js",
      "default": "./dist/catalog/legacy-resolve.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.legacy-esm.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@saha-textile/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
