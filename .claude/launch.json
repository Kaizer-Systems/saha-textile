{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "api",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--filter", "@saha-textile/api", "dev"],
			"port": 4000
		},
		{
			"name": "admin",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--filter", "@saha-textile/admin", "dev"],
			"port": 4300
		},
		{
			"name": "storefront",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--filter", "@saha-textile/storefront", "dev"],
			"port": 4200
		},
		{
			"name": "storefront-prod",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--filter", "@saha-textile/storefront", "start"],
			"port": 4200
		},
		{
			"name": "dev-portal",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"--filter",
				"@saha-textile/developer-portal",
				"exec",
				"docusaurus",
				"start",
				"--port",
				"3211",
				"--host",
				"127.0.0.1",
				"--no-open"
			],
			"port": 3211
		}
	]
}
