{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "api",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"--filter",
				"@saha-textile/api",
				"dev"
			],
			"port": 4000,
			"autoPort": false,
			"url": "https://localhost:4000"
		},
		{
			"name": "admin",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"--filter",
				"@saha-textile/admin",
				"dev"
			],
			"port": 4300,
			"autoPort": false,
			"url": "https://localhost:4300"
		},
		{
			"name": "storefront",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"--filter",
				"@saha-textile/storefront",
				"dev"
			],
			"port": 4200,
			"autoPort": false,
			"url": "https://localhost:4200",
			"env": {
				"NODE_OPTIONS": "--use-system-ca"
			}
		},
		{
			"name": "storefront-prod",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"--filter",
				"@saha-textile/storefront",
				"start"
			],
			"port": 4200,
			"autoPort": false,
			"url": "https://localhost:4200",
			"env": {
				"NODE_OPTIONS": "--use-system-ca"
			}
		},
		{
			"name": "dev-portal",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"--filter",
				"@saha-textile/developer-portal",
				"exec",
				"docusaurus",
				"start",
				"--port",
				"3211",
				"--host",
				"127.0.0.1",
				"--no-open"
			],
			"port": 3211
		},
		{
			"name": "release-console-api",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"--filter",
				"@saha-textile/release-console-api",
				"exec",
				"sh",
				"-c",
				"nest build -p tsconfig.build.json && node dist/main.js"
			],
			"port": 4410
		},
		{
			"name": "release-console",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"--filter",
				"@saha-textile/release-console",
				"dev"
			],
			"port": 4400
		},
		{
			"name": "dev-portal-snapshot",
			"runtimeExecutable": "node",
			"runtimeArgs": [
				"apps/developer-portal/node_modules/@docusaurus/core/bin/docusaurus.mjs",
				"start",
				".generated/portal-snap/apps/developer-portal",
				"--port",
				"3211",
				"--host",
				"127.0.0.1",
				"--no-open"
			],
			"port": 3211
		}
	]
}
