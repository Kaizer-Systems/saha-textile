{
  "name": "@saha-textile/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "generate:openapi": "nest build && node dist/generate-openapi.js && node scripts/check-openapi.mjs",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "e2e:session-rotation": "node e2e/session-rotation.mjs",
    "check:openapi": "node scripts/check-openapi.mjs",
    "bootstrap:first-admin": "nest build && node dist/create-first-admin.js",
    "set:local-credentials": "node --import tsx src/set-local-test-credentials.ts",
    "reset:local-customer": "node --import tsx src/reset-local-customer.ts",
    "seed:local-auth-accounts": "nest build && node dist/seed-local-auth-accounts.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@saha-textile/adapters-auth": "workspace:*",
    "@saha-textile/adapters-db-mongo": "workspace:*",
    "@saha-textile/adapters-notifications-msg91": "workspace:*",
    "@saha-textile/adapters-storage-spaces": "workspace:*",
    "@saha-textile/contracts": "workspace:*",
    "@saha-textile/core-domain": "workspace:*",
    "argon2": "0.45.1",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "jsonwebtoken": "9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/jsonwebtoken": "9.0.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
