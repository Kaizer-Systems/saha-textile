# =============================================================================
#  apps/admin/.env — Admin Angular configuration
# =============================================================================
#  cp apps/admin/.env.example apps/admin/.env   (real .env is gitignored)
#
# Browser-facing config is loaded from public/config.json by an APP_INITIALIZER.
# Deployment generates or mounts that file from these non-secret values. The
# committed config.json contains localhost defaults only; never commit production
# URLs. Production mounts overwrite config.json at deploy.
# =============================================================================

# ---- Dev server port (vite) ---------------------------------- [LOCAL] ------
PORT=4300

# ---- API endpoint (config.json -> apiUrl) -------------------- [ALL] --------
# [LOCAL]     http://localhost:4000
# [TEST-E2E]  https://api.test.<your-domain>
# [PROD-E2E]  https://api.<your-domain>
API_URL=http://localhost:4000

# ---- Site (config.json -> siteUrl / locales) ----------------- [ALL] --------
SITE_URL=http://localhost:4300
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,bn
