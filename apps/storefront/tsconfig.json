{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"noEmit": true,
		"allowJs": true,
		"declaration": false,
		"declarationMap": false,
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
