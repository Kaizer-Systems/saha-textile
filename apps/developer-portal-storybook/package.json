{
  "name": "@saha-textile/developer-portal-storybook",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:coverage": "node scripts/check-component-coverage.mjs",
    "prepare-styles": "node scripts/compose-application-styles.mjs",
    "dev": "node scripts/check-component-coverage.mjs && node scripts/compose-application-styles.mjs && ng run developer-portal-storybook:storybook",
    "storybook": "node scripts/check-component-coverage.mjs && node scripts/compose-application-styles.mjs && ng run developer-portal-storybook:storybook",
    "build": "node scripts/check-component-coverage.mjs && node scripts/compose-application-styles.mjs && ng run developer-portal-storybook:build-storybook",
    "typecheck": "node scripts/check-component-coverage.mjs && tsc --noEmit",
    "lint": "node scripts/check-component-coverage.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@angular/animations": "21.2.18",
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/forms": "21.2.18",
    "@angular/platform-browser": "21.2.18",
    "@angular/router": "21.2.18",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@jsverse/transloco": "8.4.0",
    "@ng-bootstrap/ng-bootstrap": "20.0.0",
    "@ngrx/signals": "21.1.1",
    "@ngrx/store": "21.1.1",
    "@tanstack/angular-query-experimental": "5.101.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.18",
    "@angular/cli": "21.2.18",
    "@angular/compiler-cli": "21.2.18",
    "@storybook/addon-docs": "10.3.2",
    "@storybook/angular": "10.3.2",
    "@types/feather-icons": "4.29.4",
    "sass": "1.97.3",
    "storybook": "10.3.2",
    "typescript": "5.9.3",
    "webpack": "5.108.4"
  }
}
