# =============================================================================
#  apps/api/.env  —  API runtime configuration (NestJS on Fastify)
# =============================================================================
#  HOW TO USE
#    cp apps/api/.env.example apps/api/.env   (the real .env is gitignored)
#    Fill the values for the environment you are running.
#
#  Tags below show which environment(s) each var applies to:
#    [LOCAL]     local development against the test M0 cluster
#    [TEST-E2E]  short-lived real infra (test droplet + same test M0)
#    [PROD-E2E]  production
#
#  SECURITY: the repo is PUBLIC. Never commit real values — only this template.
#  In production, inject these via Docker Compose secrets / root-owned env files.
# =============================================================================

# ---- Runtime -------------------------------------------------- [ALL] --------
NODE_ENV=development
PORT=4000
# Comma-separated allowlist of browser origins permitted by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- MongoDB (separate parts; URI assembled at runtime, @-safe) --- [ALL] ----
# The password may contain special characters (e.g. '@'); store it RAW here —
# the app percent-encodes it at runtime via encodeURIComponent(). Do NOT pre-encode.
MONGODB_USERNAME=your_db_user
MONGODB_PASSWORD=your_db_password_raw
MONGODB_CLUSTER_HOST=yourcluster.xxxxx.mongodb.net
MONGODB_DB_NAME=saha_local
MONGODB_APP_NAME=SahaTextileCluster0
# Optional: fully override the assembled URI (must be pre-encoded if set).
# MONGODB_URI=

# ---- Auth: JWT ------------------------------------------------ [ALL] --------
# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Auth: email OTP via Brevo (free tier) -------- [ALL, real later] --------
BREVO_API_KEY=
OTP_EMAIL_FROM=no-reply@sahatextile.com
OTP_TTL_SECONDS=300

# ---- Auth: social login (OAuth) ------------------- [ALL, real later] --------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=

# ---- Media storage: DigitalOcean Spaces (S3-compatible) ---- [Phase 4+] ------
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=blr1
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_CDN_URL=

# ---- Payments: CCAvenue (INR) ----------------------------- [Phase 6] --------
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
# test.ccavenue.com (test) | secure.ccavenue.com (prod)
CCAVENUE_BASE_URL=https://test.ccavenue.com

# ---- Payments: PayPal (non-INR) --------------------------- [Phase 6] --------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox

# ---- FX rates: ExchangeRate-API (free open tier needs no key) -- [Phase 7] ---
EXCHANGERATE_API_KEY=

# ---- Shipping: Shiprocket (domestic + international) ------- [Phase 6] --------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=

# ---- Rate limiting -------------------------------------------- [ALL] --------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
