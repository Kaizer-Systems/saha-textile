{
  "name": "@saha-textile/developer-portal-typedoc",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare-theme": "node scripts/compose-theme.mjs",
    "build": "node scripts/compose-theme.mjs && typedoc --options typedoc.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typedoc": "0.28.20",
    "typescript": "5.9.3"
  }
}
