{
  "name": "saha-textile",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "build:product-apps": "turbo run build --filter=@saha-textile/storefront --filter=@saha-textile/admin --filter=@saha-textile/api",
    "dev": "turbo run dev",
    "dev:storefront": "pnpm --filter @saha-textile/storefront dev",
    "dev:admin": "pnpm --filter @saha-textile/admin dev",
    "start:storefront": "node scripts/serve-built-frontend.mjs --app storefront",
    "start:admin": "node scripts/serve-built-frontend.mjs --app admin",
    "lint": "pnpm check:naming && pnpm check:account-naming && pnpm check:browser-auth && pnpm check:i18n-parity && pnpm check:route-contracts && pnpm check:route-authorization && pnpm check:permission-registry && turbo run lint",
    "check:naming": "bash scripts/check-naming.sh",
    "check:account-naming": "node scripts/check-account-naming.mjs",
    "setup:local-https": "bash scripts/setup-local-https.sh",
    "check:browser-auth": "node scripts/check-browser-auth.mjs",
    "check:i18n-parity": "node scripts/check-i18n-parity.mjs",
    "check:route-contracts": "node scripts/check-route-contracts.mjs",
    "check:route-authorization": "node scripts/check-route-authorization.mjs",
    "check:permission-registry": "node scripts/check-permission-registry.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e:session-rotation": "turbo run build --filter=@saha-textile/api && pnpm --filter @saha-textile/api e2e:session-rotation",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "portal:persistent": "node scripts/serve-developer-portal-persistent.mjs",
    "mongo:up": "bash scripts/mongo-up.sh",
    "mongo:down": "bash scripts/mongo-down.sh",
    "mongo:status": "bash scripts/mongo-status.sh",
    "mongo:wipe": "bash scripts/mongo-wipe.sh",
    "mongo:align-collections": "pnpm --filter @saha-textile/adapters-db-mongo align:collections",
    "mongo:split-admin-users": "pnpm --filter @saha-textile/adapters-db-mongo split:admin-users",
    "mongo:rename-admin-user-permissions": "pnpm --filter @saha-textile/adapters-db-mongo rename:admin-user-permissions",
    "mongo:extract-credentials": "pnpm --filter @saha-textile/adapters-db-mongo extract:credentials",
    "auth:set-local-credentials": "pnpm --filter @saha-textile/api set:local-credentials",
    "mongo:reconcile-indexes": "pnpm --filter @saha-textile/adapters-db-mongo reconcile:indexes"
  },
  "devDependencies": {
    "@saha-textile/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.5.0",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "turbo": "2.10.0",
    "typescript": "6.0.3"
  }
}
