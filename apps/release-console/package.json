{
  "name": "@saha-textile/release-console",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "The Release Console: an owner-only dashboard that runs on the owner's computer. English only; never deployed.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview --host localhost --port 4400 --strictPort",
    "lint": "eslint .",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ngrx/signals": "^22.0.1",
    "@saha-textile/release-console-contracts": "workspace:*",
    "@tanstack/angular-query-experimental": "^5.104.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@analogjs/vitest-angular": "^2.9.2",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
