# ---- MCP credential files (NEVER COMMIT) ----
.env.mcp
.env.mcp.local
.env.mcp.*.local
# Keep the template tracked:
!.env.mcp.example

# ---- Standard secrets / env ----
.env
.env.*
!.env.example
# Re-assert template re-inclusion AFTER the broad `.env.*` rule above,
# otherwise `.env.*` would re-ignore these committed templates.
!.env.mcp.example

# ---- Next.js (generated; recreated by `next typegen` / `next build`) ----
next-env.d.ts

# ---- Node / monorepo ----
node_modules/
.pnpm-store/
dist/
build/
.docusaurus/
.generated/
.next/
.turbo/
.angular/
coverage/
*.log
*.tsbuildinfo

# ---- OS / editor noise ----
.DS_Store
Thumbs.db

# ---- Vendor Theme Files ----
/vendor/

# Generated: dart-sass precompiled theme css (analog SSR dev sass-importer workaround)
apps/storefront/src/scss/app.gen.css
apps/storefront/public/assets/css/theme-dark.gen.css
apps/storefront/src/scss/dark-copy.gen.css
apps/admin/public/assets/scss/app.gen.css
apps/admin/public/assets/css/theme-dark.gen.css

# Local HTTPS certificates (mkcert). Regenerate with scripts/setup-local-https.sh —
# never commit a private key, even a locally-trusted development one.
certs/

# Throwaway root of scripts/production-proof.sh: it holds generated secrets and certificates.
.production-proof/

# Mode-3 stack runtime env (written by pnpm stack:env from the Infisical dev project) — never commit.
docker/stack/env/*.env
docker/stack/env/*.config.json
docker/stack/env/redis-password
docker/stack/env/meilisearch.toml
docker/stack/env/*.tmp
# Every file there, including the MongoDB login files (keyfile, administrator, app password) and any added later.
docker/stack/env/*

# This Mac's own service secrets (pnpm secrets:setup-local): the dev project's /infrastructure files — never commit.
docker/dev-secrets/
