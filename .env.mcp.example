# =============================================================================
#  .env.mcp  —  MCP credential switch for the Saha Textile project
# =============================================================================
#  HOW TO USE
#    1) cp .env.mcp.example .env.mcp        (the real .env.mcp is gitignored)
#    2) Fill in real values below.
#    3) Keep EXACTLY ONE phase block uncommented. Comment the other two.
#    4) Restart Cursor (it reads env at process-spawn time).
#
#  PHASES
#    LOCAL     = constant local development. Only Context7, MongoDB (-> local
#                Docker rs0 via `pnpm mongo:up`), Postman (-> localhost).
#                No GitHub / DigitalOcean.
#    TEST-E2E  = real but short-lived prod-grade infra (test droplet running
#                the same Docker Mongo rs0 profile, Spaces, GitHub Actions).
#                Destroy infra after testing.
#    PROD-E2E  = real production (Docker Mongo on the prod droplet). MongoDB
#                is READ-ONLY. GitHub is read-oriented.
#
#  NOTE: every MCP server runs as stdio, so ${env:VAR} resolves reliably and the
#  Cursor remote-header interpolation bug never applies.
# =============================================================================


# ============================ PHASE: LOCAL (active) ==========================
export CONTEXT7_API_KEY=""                                  # optional (free tier works empty)
export POSTMAN_API_KEY="REPLACE_ME_POSTMAN_KEY"
# Local Docker MongoDB 8.3 single-node replica set (start with `pnpm mongo:up`).
# The local profile runs without auth, so no credentials are needed here.
export MDB_MCP_CONNECTION_STRING="mongodb://127.0.0.1:27017/saha_textile_local?replicaSet=rs0&directConnection=true"
export MDB_MCP_READ_ONLY="false"
# GitHub & DigitalOcean intentionally NOT set in LOCAL (they stay dark).


# ========================= PHASE: TEST-E2E (commented) =======================
# export CONTEXT7_API_KEY=""
# export POSTMAN_API_KEY="REPLACE_ME_POSTMAN_KEY"
# NOTE: single pre-assembled string — percent-encode special password chars
# (e.g. '@' -> %40, ':' -> %3A, '/' -> %2F). Must include replicaSet=rs0.
# export MDB_MCP_CONNECTION_STRING="mongodb://<rw-user>:<url-encoded-pwd>@<test-droplet-host>:27017/saha_textile_test?replicaSet=rs0&directConnection=true"   # test droplet Docker Mongo
# export MDB_MCP_READ_ONLY="false"
# export GITHUB_PERSONAL_ACCESS_TOKEN="REPLACE_ME_GH_PAT"
# export GITHUB_TOOLSETS="actions,repos"
# export GITHUB_READ_ONLY="false"
# export DIGITALOCEAN_API_TOKEN="REPLACE_ME_DO_TEST_TOKEN"


# ========================= PHASE: PROD-E2E (commented) =======================
# export CONTEXT7_API_KEY=""
# export POSTMAN_API_KEY="REPLACE_ME_POSTMAN_KEY"
# export MDB_MCP_CONNECTION_STRING="mongodb://<readonly-user>:<url-encoded-pwd>@<prod-droplet-host>:27017/saha_textile_prod?replicaSet=rs0&directConnection=true"   # PROD Docker Mongo, read-only user
# export MDB_MCP_READ_ONLY="true"
# export GITHUB_PERSONAL_ACCESS_TOKEN="REPLACE_ME_GH_PAT"
# export GITHUB_TOOLSETS="actions,repos"
# export GITHUB_READ_ONLY="true"
# export DIGITALOCEAN_API_TOKEN="REPLACE_ME_DO_PROD_TOKEN"
