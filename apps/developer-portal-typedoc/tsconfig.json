{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@saha-textile/contracts": ["../../packages/contracts/src/index.ts"]
		}
	},
	"include": ["../../packages/contracts/src/**/*.ts", "../../packages/core-domain/src/**/*.ts"]
}
