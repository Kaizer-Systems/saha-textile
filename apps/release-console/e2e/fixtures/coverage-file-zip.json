		"text": [
			"import { inflateRawSync } from 'node:zlib';",
			"",
			"/** A zip the console cannot read; the message is safe to show. */",
			"export class ZipError extends Error {}",
			"",
			"const END = 0x06054b50;",
			"const CENTRAL = 0x02014b50;",
			"const LOCAL = 0x04034b50;",
			"",
			"/**",
			" * The files of a zip archive (a GitHub Actions artifact) whose names `want` accepts, read with Node's own",
			" * zlib: stored and deflated entries, as GitHub writes them. A zip64 archive (over 4 GB or 65,535 files) is",
			" * refused, since a coverage run is far smaller.",
			" */",
			"export function unzip(buf: Buffer, want: (name: string) => boolean = () => true): Map<string, Buffer> {",
			"\tlet end = -1;",
			"\tfor (let i = buf.length - 22; i >= Math.max(0, buf.length - 22 - 0xffff); i--)",
			"\t\tif (buf.readUInt32LE(i) === END) {",
			"\t\t\tend = i;",
			"\t\t\tbreak;",
			"\t\t}",
			"\tif (end < 0) throw new ZipError('The coverage reports are not a zip archive.');",
			"\tconst count = buf.readUInt16LE(end + 10);",
			"\tlet at = buf.readUInt32LE(end + 16);",
			"\tif (count === 0xffff || at === 0xffffffff) throw new ZipError('The coverage reports are too large to read.');",
			"\tconst out = new Map<string, Buffer>();",
			"\tfor (let n = 0; n < count; n++) {",
			"\t\tif (at + 46 > buf.length || buf.readUInt32LE(at) !== CENTRAL)",
			"\t\t\tthrow new ZipError('The coverage reports are a damaged zip archive.');",
			"\t\tconst method = buf.readUInt16LE(at + 10);",
			"\t\tconst size = buf.readUInt32LE(at + 20);",
			"\t\tconst nameLength = buf.readUInt16LE(at + 28);",
			"\t\tconst skip = nameLength + buf.readUInt16LE(at + 30) + buf.readUInt16LE(at + 32);",
			"\t\tconst local = buf.readUInt32LE(at + 42);",
			"\t\tconst name = buf.toString('utf8', at + 46, at + 46 + nameLength);",
			"\t\tat += 46 + skip;",
			"\t\tif (name.endsWith('/') || !want(name)) continue;",
			"\t\tif (local + 30 > buf.length || buf.readUInt32LE(local) !== LOCAL)",
			"\t\t\tthrow new ZipError('The coverage reports are a damaged zip archive.');",
			"\t\tconst start = local + 30 + buf.readUInt16LE(local + 26) + buf.readUInt16LE(local + 28);",
			"\t\tconst raw = buf.subarray(start, start + size);",
			"\t\tif (method === 0) out.set(name, Buffer.from(raw));",
			"\t\telse if (method === 8) out.set(name, inflateRawSync(raw));",
			"\t\telse throw new ZipError(`The coverage reports use a zip method the console cannot read (${method}).`);",
			"\t}",
			"\treturn out;",
			"}"
		],
