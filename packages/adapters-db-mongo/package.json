{
  "name": "@saha-textile/adapters-db-mongo",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "generate:catalogue": "node --import tsx scripts/generate-catalogue.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:showcase-catalogue": "node --env-file=../../apps/api/.env --import tsx scripts/seed-showcase-catalogue.ts",
    "migrate:french-to-bengali": "node --env-file=../../apps/api/.env --import tsx scripts/migrate-french-to-bengali.ts",
    "seed:demo-catalogue": "node --env-file=../../apps/api/.env --import tsx scripts/seed-demo-catalogue.ts",
    "align:collections": "tsx scripts/align-collection-names.ts",
    "align:filter-values": "node --env-file=../../apps/api/.env --import tsx scripts/align-filter-values.ts",
    "split:admin-users": "tsx scripts/split-admin-users.ts",
    "rename:admin-user-permissions": "tsx scripts/rename-admin-user-permissions.ts",
    "extract:credentials": "tsx scripts/extract-credentials.ts",
    "seed:system-roles": "tsx scripts/seed-system-roles.ts",
    "ratings:recompute": "node --env-file=../../apps/api/.env --import tsx scripts/recompute-ratings.ts",
    "reconcile:indexes": "tsx scripts/reconcile-indexes.ts"
  },
  "dependencies": {
    "@saha-textile/contracts": "workspace:*",
    "@saha-textile/core-domain": "workspace:*",
    "mongoose": "9.11.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
