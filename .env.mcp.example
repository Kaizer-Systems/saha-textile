# =============================================================================
#  .env.mcp  —  MCP credential switch for the Saha Textile project
# =============================================================================
#  HOW TO USE
#    1) cp .env.mcp.example .env.mcp        (the real .env.mcp is gitignored)
#    2) Fill in real values below.
#    3) Keep EXACTLY ONE phase block uncommented. Comment the other two.
#    4) Restart Cursor (it reads env at process-spawn time).
#
#  PHASES
#    LOCAL     = constant local development. Context7, MongoDB (-> local Docker
#                Mongo 8.3 RS), Postman (-> localhost API). No GitHub / DO.
#    TEST-E2E  = short-lived real infra (droplet Mongo + GitHub + DO).
#    PROD-E2E  = production. MongoDB MCP READ-ONLY. GitHub read-oriented.
#
#  Claude Code note: Cursor MCP (.env.mcp) is Cursor-specific. Claude Code uses
#  shell + docker + apps/api/.env. Keep both URIs pointing at the same local RS.
# =============================================================================


# ============================ PHASE: LOCAL (active) ==========================
export CONTEXT7_API_KEY=""                                  # optional (free tier works empty)
export POSTMAN_API_KEY="REPLACE_ME_POSTMAN_KEY"
# Local Docker Mongo (pnpm mongo:up). Percent-encode password if you add auth later.
export MDB_MCP_CONNECTION_STRING="mongodb://127.0.0.1:27017/saha_local?replicaSet=rs0&directConnection=true"
export MDB_MCP_READ_ONLY="false"
# GitHub & DigitalOcean intentionally NOT set in LOCAL (they stay dark).


