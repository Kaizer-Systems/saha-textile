# =============================================================================
#  apps/api/.env  —  API runtime configuration (NestJS on Fastify)
# =============================================================================
#  HOW TO USE
#    cp apps/api/.env.example apps/api/.env   (the real .env is gitignored)
#    Fill the values for the environment you are running.
#
#  Tags below show which environment(s) each var applies to:
#    [LOCAL]     local development against the local Docker MongoDB replica set
#    [TEST-E2E]  short-lived real infra (test droplet, Docker MongoDB)
#    [PROD-E2E]  production droplet (Docker MongoDB)
#
#  SECURITY: the repo is PUBLIC. Never commit real values — only this template.
#  In deployed environments these are injected via GitHub Actions encrypted
#  secrets → root-owned env files / Docker Compose secrets. Secrets reach the
#  API container ONLY — never the Angular apps (they get public config.json).
# =============================================================================

# ---- Runtime -------------------------------------------------- [ALL] --------
NODE_ENV=development
PORT=4000
# Comma-separated allowlist of browser origins permitted by CORS.
# LOCAL: storefront :4200 + admin :4300 + persistent portal :3457.
# Deploys: explicit real origins only.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,http://127.0.0.1:3457,http://localhost:3457

# ---- Reverse proxy / client IP ------------------- [deploys behind Nginx] ----
# LOCAL: false / empty. TEST/PROD (Cloudflare → Nginx → API):
#   TRUST_PROXY=true and CLIENT_IP_HEADER=cf-connecting-ip so rate-limiting
#   and audit logs see the real client IP, not the proxy.
TRUST_PROXY=false
CLIENT_IP_HEADER=

# Pino log level for request/application logs. Secrets (authorization, cookie,
# set-cookie, x-csrf-token, password/pin/code/token bodies) are redacted at the
# logger regardless of level. Tests force `silent`.
LOG_LEVEL=info

# ---- MongoDB (self-hosted Docker 8.3, single-node replica set rs0) -- [ALL] --
# Same Docker profile in local/test/prod (see docker/mongo + `pnpm mongo:up`).
# The password may contain special characters (e.g. '@'); store it RAW here —
# the app percent-encodes it at runtime via encodeURIComponent(). Do NOT pre-encode.
# LOCAL default profile runs without auth: leave USERNAME/PASSWORD empty.
# If your machine already runs a native mongod on 27017, override the Docker
# host port via gitignored docker/mongo/.env (MONGO_HOST_PORT) and mirror the
# same value in MONGODB_PORT here — see docker/mongo/docker-compose.yml.
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_REPLICA_SET=rs0
MONGODB_DB_NAME=saha_textile_local
MONGODB_APP_NAME=saha-textile-api
# Optional: fully override the assembled URI (must be pre-encoded and include
# replicaSet=rs0). e.g. mongodb://127.0.0.1:27017/saha_textile_local?replicaSet=rs0&directConnection=true
# MONGODB_URI=

# ---- Search: Meilisearch (self-hosted, behind SearchPort) --- [Chunk F] ------
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# ---- Auth: JWT (transitional bearer until Chunk D cookie sessions) - [ALL] ---
# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Auth: cookie sessions + CSRF (wired fully in Chunk D) --------- [ALL] ---
# httpOnly/Secure/SameSite cookie sessions with double-submit CSRF are the
# locked target; names/placeholders live here so deploy tooling stays stable.
# COOKIE_DOMAIN: empty on LOCAL; apex domain in deploys for cross-subdomain auth.
COOKIE_DOMAIN=
ACCESS_COOKIE_NAME=st_access
REFRESH_COOKIE_NAME=st_refresh
CSRF_COOKIE_NAME=st_csrf
CSRF_HEADER_NAME=x-csrf-token
# Generate with: openssl rand -hex 48
CSRF_SECRET=

# ---- Notifications: MSG91 primary via NotificationPort ------------- [ALL] ---
# Provider: console (LOCAL default — logs instead of sending) | msg91 (real).
# MSG91 covers SMS / WhatsApp / Email (incl. auth OTP) behind NotificationPort.
# Authkey is API env ONLY — never pasted in admin UI (owner lock option A).
NOTIFICATION_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_EMAIL_FROM=no-reply@sahatextile.com
MSG91_EMAIL_DOMAIN=
MSG91_WHATSAPP_NUMBER=

# ---- Notifications: optional email FALLBACK only (never primary) --- [ALL] ---
# disabled (default) | resend | ses | smtp — adapter-swappable email fallback
# behind NotificationPort/EmailPort. MSG91 remains the primary provider.
EMAIL_FALLBACK_PROVIDER=disabled
RESEND_API_KEY=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ---- Auth: OTP policy ---------------------------------------------- [ALL] ---
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# ---- Auth: social login (OAuth) ------------------- [ALL, real later] --------
# Client IDs are public (also delivered to Angular via config.json);
# SECRETS live only here in the API env — never in the browser.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=

# ---- Media storage: DigitalOcean Spaces (S3-compatible, SGP) - [Phase 4+] ----
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=sgp1
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_CDN_URL=

# ---- Payments: CCAvenue (INR gateway role; adapter-swappable) - [Phase 6] ----
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
# test.ccavenue.com (test) | secure.ccavenue.com (prod)
CCAVENUE_BASE_URL=https://test.ccavenue.com

# ---- Payments: PayPal (non-INR) --------------------------- [Phase 6] --------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox

# ---- FX rates: ExchangeRate-API (free open tier needs no key) -- [Phase 7] ---
EXCHANGERATE_API_KEY=

# ---- Shipping: Shiprocket (domestic + international) ------- [Phase 6] --------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=

# ---- Rate limiting -------------------------------------------- [ALL] --------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
