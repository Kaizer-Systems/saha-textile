{
  "name": "@saha-textile/developer-portal-storybook",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare-styles": "node scripts/compose-application-styles.mjs",
    "dev": "node scripts/compose-application-styles.mjs && ng run developer-portal-storybook:storybook",
    "storybook": "node scripts/compose-application-styles.mjs && ng run developer-portal-storybook:storybook",
    "build": "node scripts/compose-application-styles.mjs && ng run developer-portal-storybook:build-storybook",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@angular/animations": "21.2.18",
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/platform-browser": "21.2.18",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@jsverse/transloco": "8.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.18",
    "@angular/cli": "21.2.18",
    "@angular/compiler-cli": "21.2.18",
    "@storybook/addon-docs": "10.3.2",
    "@storybook/angular": "10.3.2",
    "sass": "1.97.3",
    "storybook": "10.3.2",
    "typescript": "5.9.3"
  }
}
